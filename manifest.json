{
  "manifest_version": 3,
  "name": "Paramount++",
  "version": "2.4.1",
  "description": "Pins Paramount+ playback to the highest video quality listed in its own manifest. Local build, no network access.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.paramountplus.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.paramountplus.com/*"],
      "js": ["failover.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://*.paramountplus.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js"],
      "matches": ["*://*.paramountplus.com/*"]
    }
  ],
  "action": {
    "default_title": "Paramount++",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "paramount-force-max@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
